# ============================================================================
# MaxOne backend — LOCAL DEVELOPMENT template. Copy to .env and fill in values.
# Production values are set per service on Render/Vercel — see DEPLOY.md (env-var matrix).
# Every URL below is required: the code has NO localhost fallbacks (M17).
# ============================================================================

# --- Postgres (docker-compose creates this user/db) ---
POSTGRES_USER="wallet"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="wallet_db"
# Must match the POSTGRES_* values above. Prod: the Neon connection string.
DATABASE_URL="postgresql://wallet:change-me@localhost:5432/wallet_db"
# Integration lane (M15b): a SEPARATE *_test database, truncated per test. Runner refuses anything else.
TEST_DATABASE_URL="postgresql://wallet:change-me@localhost:5432/wallet_db_test"

# --- Auth ---
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
# Passkeys (M14): the RP ID is the customer app's bare hostname, the origin its full URL.
# Prod: WEBAUTHN_RP_ID="<customer>.vercel.app", WEBAUTHN_ORIGIN="https://<customer>.vercel.app"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="MaxOne"
WEBAUTHN_ORIGIN="http://localhost:3300"

# --- Web Push (M12): generate once with `npx web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:you@example.com"

# --- App server ---
PORT=3100
# CORS: the only browser origin that talks to the API directly (the customer app's WebSocket).
FRONTEND_ORIGIN="http://localhost:3300"

# --- Redis cache (M16a): db 0 = app, db 1 = integration tests (flushed per test) ---
# Prod: Upstash `rediss://default:<token>@<host>:6379/0` (TLS — ioredis handles rediss://).
REDIS_URL="redis://localhost:6379/0"
TEST_REDIS_URL="redis://localhost:6379/1"

# --- RabbitMQ (M16b–d): vhost "/" = app, vhost "test" = integration lane (recreated per run) ---
# Prod: CloudAMQP `amqps://<user>:<pass>@<host>/<user>` (TLS — amqplib handles amqps://).
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
TEST_RABBITMQ_URL="amqp://guest:guest@localhost:5672/test"
RABBITMQ_MANAGEMENT_URL="http://localhost:15672"

# --- Observability (M17) ---
LOG_LEVEL="info"            # pino level: trace|debug|info|warn|error
SERVICE_NAME="api"          # "api" or "worker" — tags every log line
# SENTRY_DSN=""             # leave unset to disable error tracking entirely
