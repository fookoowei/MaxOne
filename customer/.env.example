# Customer app (Next.js, :3300). Copy to .env.local. Prod values: Vercel project env (DEPLOY.md).
API_BASE_URL="http://localhost:3100"                 # server-side only (BFF → API). Prod: https://maxone-backend.onrender.com
NEXT_PUBLIC_WS_URL="http://localhost:3100"           # browser → API Socket.IO. REQUIRED, no fallback. Prod: same Render URL
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."                   # must equal the backend's VAPID_PUBLIC_KEY
